# Application
APP_NAME=AI Resume Analyzer
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./resume_analyzer.db

# Google Gemini (LLM + embeddings API — no local ML models)
GEMINI_API_KEY=your_gemini_api_key_here
# Use flash-lite on free tier to avoid quota limits
GEMINI_MODEL=gemini-2.0-flash-lite
EMBEDDING_MODEL=models/embedding-001

# Supabase pgvector (required for RAG on Render free tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_TABLE_NAME=documents
SUPABASE_QUERY_NAME=match_documents

# RAG chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# CORS (semicolon between URLs if host restricts commas)
CORS_ORIGINS=http://localhost:5173;http://localhost:3000

# Paths
UPLOAD_DIR=uploads
